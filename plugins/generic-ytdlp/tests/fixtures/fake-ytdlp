#!/bin/sh
set -eu

# This fixture is intentionally local and ignores the source URL.  It exists
# only to exercise the plugin's argv, timeout and output-boundary tests.
source_url="${4:-}"
case "$source_url" in
  *mode=timeout*) sleep 2 ;;
  *mode=stdout-overflow*) while :; do printf '%s' 'stdout-overflow'; done ;;
  *mode=stderr-overflow*) while :; do printf '%s' 'stderr-overflow' >&2; done ;;
  *mode=nonzero*) printf '%s' 'fixture stderr secret' >&2; exit 7 ;;
  *) printf '%s' '{"title":"fixture media","protection":"clear","streams":[{"id":"primary","protocol":"http-file","url":"https://cdn.example.test/video.mp4","public_headers":{"Accept":"video/mp4"},"upstream_access_ref":null}]}' ;;
esac
